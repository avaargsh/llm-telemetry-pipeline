FROM golang:1.27.4-alpine AS build
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN test "$(go env GOVERSION)" = go1.27.4 && go mod download
COPY cmd/lag-exporter ./cmd/lag-exporter
COPY internal/lagmonitor ./internal/lagmonitor
COPY internal/lagrisk ./internal/lagrisk
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /lag-exporter ./cmd/lag-exporter

FROM alpine:3.21
RUN addgroup -S telemetry && adduser -S -G telemetry telemetry
COPY --from=build /lag-exporter /usr/local/bin/lag-exporter
USER telemetry
ENTRYPOINT ["/usr/local/bin/lag-exporter"]
