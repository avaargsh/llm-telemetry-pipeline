FROM golang:1.27.4-alpine AS build
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN test "$(go env GOVERSION)" = go1.27.4 && go mod download && go mod verify
COPY cmd/genai-observation-worker ./cmd/genai-observation-worker
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /genai-observation-worker ./cmd/genai-observation-worker

FROM alpine:3.21
RUN apk add --no-cache ca-certificates && addgroup -S telemetry && adduser -S -G telemetry telemetry
COPY --from=build /genai-observation-worker /usr/local/bin/genai-observation-worker
USER telemetry
EXPOSE 9109
ENTRYPOINT ["/usr/local/bin/genai-observation-worker"]
