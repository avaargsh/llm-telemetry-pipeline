# Use a worker-specific LOGIN principal granted llm_telemetry_observation_worker.
# Inject authentication through your secret manager / pgpass mechanism; do not store passwords here.
GENAI_OBSERVATION_DATABASE_URL=postgres://worker_login@postgres:5432/telemetry?sslmode=verify-full
GENAI_OBSERVATION_RECEIVER_URL=https://receiver.example/v1/traces
GENAI_OBSERVATION_RECEIVER_TOKEN=replace-with-a-random-secret-at-least-32-characters
GENAI_OBSERVATION_WORKER_ID=genai-observation-worker-1
GENAI_OBSERVATION_QUEUE_CAPACITY=10000
GENAI_OBSERVATION_POLL_INTERVAL=1s
GENAI_OBSERVATION_LEASE=30s
GENAI_OBSERVATION_HTTP_TIMEOUT=10s
GENAI_OBSERVATION_MAX_ATTEMPTS=5
GENAI_OBSERVATION_INITIAL_BACKOFF=1s
GENAI_OBSERVATION_MAX_BACKOFF=30s
GENAI_OBSERVATION_RETRY_JITTER=0.2
GENAI_OBSERVATION_METRICS_ADDR=127.0.0.1:9109
