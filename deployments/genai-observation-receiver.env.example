# Use a receiver-specific login principal that is a member of the receiver capability role.
# Inject database authentication using the deployment's secret manager / pgpass mechanism.
GENAI_OBSERVATION_DATABASE_URL=postgres://receiver_login@postgres:5432/telemetry?sslmode=verify-full
GENAI_OBSERVATION_CREDENTIALS_FILE=/run/secrets/receiver-credentials.json
GENAI_OBSERVATION_LISTEN_ADDR=:4318
GENAI_OBSERVATION_TLS_CERT_FILE=/run/secrets/tls.crt
GENAI_OBSERVATION_TLS_KEY_FILE=/run/secrets/tls.key
GENAI_OBSERVATION_QUEUE_CAPACITY=10000
GENAI_OBSERVATION_MAX_CONCURRENT=8
GENAI_OBSERVATION_HTTP_TIMEOUT=15s
