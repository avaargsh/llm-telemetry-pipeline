# Standalone read-only reconciliation CronJob runtime. Build and publish your
# own digest-pinned image; this Dockerfile does not publish any image.
FROM golang:1.23.12-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/reconciler ./cmd/reconciler

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=build /out/reconciler /usr/local/bin/reconciler
COPY scripts/m6_scheduled_reconcile.py /app/m6_scheduled_reconcile.py
USER 65532:65532
WORKDIR /app
ENTRYPOINT ["python3", "/app/m6_scheduled_reconcile.py"]
